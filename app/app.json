{
  "expo": {
    "name": "PredictAI",
    "slug": "predictai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.predictai.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock your PredictAI account."
      }
    },
    "android": {
      "package": "com.predictai.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely unlock your PredictAI account."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PredictAI to scan wallet QR codes for withdrawals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PredictAI to choose a profile photo from your library."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "968256f3-47f9-4966-ae04-a62ce9942480"
      }
    },
    "owner": "akademiapp21s-organization"
  }
}
